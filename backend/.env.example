# ==============================================================================
# MẪU CẤU HÌNH BIẾN MÔI TRƯỜNG CHO BACKEND (DÊ HƯƠNG SƠN RESTAURANT)
# ==============================================================================

# Cổng khởi chạy Server
PORT=5001
NODE_ENV=development

# Cơ sở dữ liệu MySQL
DB_HOST=localhost
DB_PORT=3307
DB_USER=restaurant_user
DB_PASSWORD=restaurant_pass
DB_NAME=restaurant_db

# Xác thực bảo mật JWT
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# Đường dẫn URL Frontend
APP_URL=http://localhost:5173

# Cấu hình CORS Whitelist (Phân tách bằng dấu phẩy)
# Ví dụ: http://localhost:5173,https://dehuongson.vn,https://admin.dehuongson.vn
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:4173

# Cấu hình Cổng thanh toán SePay Webhook
# Bắt buộc phải có trên môi trường production
SEPAY_WEBHOOK_SECRET=your_sepay_webhook_secret_here

# Dịch vụ gửi Email thông báo (Nodemailer / Gmail App Password)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password

